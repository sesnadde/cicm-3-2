# Copia este archivo como .env y completa los valores. .env NUNCA se versiona.

# production en el servidor público (activa HSTS y cookies Secure)
NODE_ENV=development
PORT=3000
# HOST=0.0.0.0

# Saltos de proxy inverso confiables (p. ej. 1 detrás de Render, Railway, Fly, nginx o Cloud Run).
# Necesario para obtener la IP real (límite de intentos de inicio de sesión).
TRUST_PROXY=

# --- Supabase (opcional: sin estas variables el portal funciona, pero sin administración) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Llave publicable (sb_publishable_...): solo se usa en el servidor para verificar contraseñas.
SUPABASE_PUBLISHABLE_KEY=
# Llave service_role: SOLO servidor. Nunca la expongas en el navegador ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=
# Solo para `npm run db:setup` (requiere salida al puerto 5432).
DATABASE_URL=

# Obligatoria si hay Supabase (mínimo 32 caracteres). Firma la cookie de sesión de administración.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
